baseurl = "/"
languageCode = "en"
title = "NT docs"
theme = "docs"
copyright = "&copy; 2025 <a href=\"https://northern.tech\">Northern.tech</a> AS"
enableRobotsTXT = true
relativeURLs = true

[params]
branch = "master"
repositoryUrl = "https://github.com/cfengine/documentation"
searchBaseUrl = "/api/search"
domain = "docs.northern.tech"
# Used as the summary line in llms.txt
description = "Northern.tech product documentation."

# Number of posts per page
[pagination]
pagerSize = 10

[taxonomies]
tag = "tags"

[markup]
[markup.highlight]
style = 'pygments'
codeFences = true
pygmentsCodeFences = true
wrapperClass = 'hlc'

[markup.goldmark.renderer]
  unsafe = true # Allow HTML in md files

[params.theme.colors]
  primary = "#15357f" # home page h1
  secondary = "#f5821f"
  link = "#1d71d3"
  footer = "#052569"

# llms.txt (https://llmstxt.org), see
# https://github.com/gethugothemes/hugo-modules/tree/main/llms-txt
[module]
[[module.imports]]
path = "github.com/gethugothemes/hugo-modules/llms-txt"

[outputs]
home = ["HTML", "RSS", "llms", "llmsfull", "md"]
section = ["HTML", "RSS", "md"]
page = ["HTML", "md"]

[params.llms]
generate_llms_txt = true
generate_llms_full_txt = true
include = []
exclude = ["/tags/**"]
